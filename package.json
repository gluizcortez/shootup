{
  "name": "shootup",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ShootUp! — arena 2D lateral, shoot 'em up roguelite com animais cômicos.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
